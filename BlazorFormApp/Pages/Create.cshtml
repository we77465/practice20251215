@page
@model CreateModel

@functions {
    public class CreateModel : Microsoft.AspNetCore.Mvc.RazorPages.PageModel
    {
        public void OnGet()
        {
            // 保留 empNo 參數並導向到 Edit 頁面
            string empNo = Request.Query["empNo"];
            if (!string.IsNullOrEmpty(empNo))
            {
                Response.Redirect($"/Edit?empNo={empNo}");
            }
            else
            {
                Response.Redirect("/Edit");
            }
        }
    }
}
