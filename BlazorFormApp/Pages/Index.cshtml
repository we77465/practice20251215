@page
@model IndexModel
@{
    ViewData["Title"] = "商品查詢";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: 'Microsoft JhengHei', Arial, sans-serif;
            margin: 20px;
            background-color: #f5f5f5;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        h1 {
            color: #333;
            border-bottom: 2px solid #007bff;
            padding-bottom: 10px;
        }
        .search-panel {
            background-color: #f8f9fa;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: inline-block;
            width: 100px;
            font-weight: bold;
        }
        input[type="text"], select {
            padding: 5px 10px;
            border: 1px solid #ddd;
            border-radius: 3px;
            width: 200px;
        }
        .btn {
            padding: 8px 20px;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            font-size: 14px;
            margin-right: 10px;
        }
        .btn-primary {
            background-color: #007bff;
            color: white;
        }
        .btn-success {
            background-color: #28a745;
            color: white;
        }
        .btn:hover {
            opacity: 0.8;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th {
            background-color: #007bff;
            color: white;
            padding: 10px;
            text-align: left;
        }
        td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }
        tr:hover {
            background-color: #f8f9fa;
        }
        .user-info {
            text-align: right;
            color: #666;
            margin-bottom: 10px;
            font-size: 14px;
        }
        .action-link {
            color: #007bff;
            text-decoration: none;
            margin-right: 10px;
        }
        .action-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="user-info">
            登入者：@Model.CurrentUser
        </div>
        
        <h1>@ViewData["Title"]</h1>
        
        <div class="search-panel">
            <form method="post">
                <div class="form-group">
                    <label>商品名稱：</label>
                    <input type="text" name="ProductName" value="@Model.SearchProductName" />
                </div>
                <div class="form-group">
                    <label>商品類別：</label>
                    <select name="Category">
                        <option value="">全部</option>
                        <option value="爬蟲類">爬蟲類</option>
                        <option value="飼料">飼料</option>
                        <option value="設備">設備</option>
                    </select>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">查詢</button>
                    <a href="/Create?empNo=@Model.CurrentUser" class="btn btn-success">新增商品</a>
                </div>
            </form>
        </div>

        <table>
            <thead>
                <tr>
                    <th>商品編號</th>
                    <th>商品名稱</th>
                    <th>類別</th>
                    <th>價格</th>
                    <th>庫存</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Category</td>
                        <td>$@item.Price</td>
                        <td>@item.Stock</td>
                        <td>
                            <a href="/Detail?id=@item.Id&empNo=@Model.CurrentUser" class="action-link">明細</a>
                            <a href="/Edit?id=@item.Id&empNo=@Model.CurrentUser" class="action-link">編輯</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>

@functions {
    public class IndexModel : Microsoft.AspNetCore.Mvc.RazorPages.PageModel
    {
        public string CurrentUser { get; set; } = "";
        public string SearchProductName { get; set; } = "";
        public List<ProductItem> Products { get; set; } = new List<ProductItem>();

        public void OnGet()
        {
            // 取得登入者資訊
            CurrentUser = AuthHelper.GetEmpNo(Request.Query);
            
            // 載入商品資料（示範用假資料）
            LoadProducts();
        }

        public void OnPost()
        {
            // 取得登入者資訊
            CurrentUser = AuthHelper.GetEmpNo(Request.Query);
            
            // 取得搜尋條件
            SearchProductName = Request.Form["ProductName"];
            
            // 載入商品資料
            LoadProducts();
        }

        private void LoadProducts()
        {
            // 示範用假資料
            Products = new List<ProductItem>
            {
                new ProductItem { Id = "P001", Name = "綠鬣蜥", Category = "爬蟲類", Price = 3500, Stock = 5 },
                new ProductItem { Id = "P002", Name = "豹紋守宮", Category = "爬蟲類", Price = 2800, Stock = 8 },
                new ProductItem { Id = "P003", Name = "爬蟲專用飼料", Category = "飼料", Price = 450, Stock = 50 },
                new ProductItem { Id = "P004", Name = "紫外線燈具", Category = "設備", Price = 1200, Stock = 15 },
                new ProductItem { Id = "P005", Name = "玉米蛇", Category = "爬蟲類", Price = 4200, Stock = 3 }
            };

            // 如果有搜尋條件，進行過濾
            if (!string.IsNullOrEmpty(SearchProductName))
            {
                Products = Products.Where(p => p.Name.Contains(SearchProductName)).ToList();
            }
        }
    }

    public class ProductItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Price { get; set; }
        public int Stock { get; set; }
    }
}
